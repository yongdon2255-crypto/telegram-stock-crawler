# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example
config/session.json
config/state.json
config/web-state.json

# Telegram session string (저장 시 별도 파일로 쓸 경우)
*.session
session.txt

# Raw data (원본 보관은 로컬만, git에 올리지 않음)
inbox/*
!inbox/.gitkeep
processed/*
!processed/.gitkeep

# Obsidian workspace files (vault 경로가 이 repo 안에 있을 경우)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# 개인 스크린샷
docs/image/

# 생성된 PDF (로컬 전용)
docs/pdf/

# macOS
.DS_Store
**/.DS_Store

# Logs
logs/*
!logs/.gitkeep
*.log
npm-debug.log*

# Runtime
*.pid
.nyc_output/
coverage/

# Python (scrapers/)
scrapers/.venv/
scrapers/__pycache__/
scrapers/**/__pycache__/
# Naver 세션 자격증명 (Chromium 영속 프로필 — 절대 커밋 금지)
scrapers/.state/*
!scrapers/.state/.gitkeep

# IDE
.vscode/settings.json
.idea/
