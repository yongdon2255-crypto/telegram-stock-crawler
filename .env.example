# Telegram MTProto (my.telegram.org에서 발급)
TG_API_ID=
TG_API_HASH=
TG_SESSION=          # 첫 실행(node src/auth.js) 후 자동 생성되는 세션 문자열

# 리포트 수신 대상 (me = 내 저장 메시지 / 숫자 ID = 특정 채팅)
REPORT_CHAT_ID=me

# Obsidian
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/Obsidian/Main

# 데이터 보존 기간 (days)
RETENTION_DAYS=7
