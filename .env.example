# Telegram MTProto (my.telegram.org에서 발급)
TG_API_ID=
TG_API_HASH=
TG_SESSION=          # 첫 실행(node src/auth.js) 후 자동 생성되는 세션 문자열

# 리포트 수신 대상 (me = 내 저장 메시지 / 숫자 ID = 특정 채팅)
REPORT_CHAT_ID=me

# Obsidian
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/Obsidian/Main

# 데이터 보존 기간 (days)
RETENTION_DAYS=7

# 네이버 프리미엄 콘텐츠 크롤러 (선택)
# Scrapling 프로필 디렉터리. 비워두면 scrapers/.state/naver-profile 사용.
# Playwright storage_state 파일. 비워두면 scrapers/.state/naver-storage-state.json 사용.
# 최초 'npm run naver:login' 으로 수동 로그인하여 쿠키 저장 후 사용.
NAVER_PROFILE_DIR=
NAVER_STORAGE_STATE=
